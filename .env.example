# NARA Swarm Monitor Environment Variables

# The Base Mainnet or local fork Chain ID.
CHAIN_ID=8453
MONITOR_PROFILE=core

# RPC configuration
BASE_RPC_URL=https://mainnet.base.org
BASE_BACKUP_RPC_URL_1=https://base.publicnode.com
BASE_BACKUP_RPC_URL_2=https://base.drpc.org

# Fresh v4 redeploy values only. No v3 or retired incident-stack addresses.
# core requires token, engine, liquidity hook, vault, and compounder.
# full additionally requires every deferred surface below.
V4_START_BLOCK=
V4_EPOCH_LENGTH_SECONDS=
V4_MAX_EPOCH_BACKLOG=1
V4_NARA_TOKEN=
V4_ENGINE=
V4_POSITION_NFT=
V4_BOND_DEPOSITORY_NFT=
V4_BOND_VAULT=
V4_OPS_VAULT=
V4_ENGINE_OPS_ROUTER=
V4_BREAK_GLASS_SAFE=
V4_STAKING_POOL=
V4_STAKING_POOL_SY=
V4_FRACTIONAL_FACTORY=
V4_LIQUIDITY_GROWTH_HOOK=
V4_LIQUIDITY_GROWTH_VAULT=
V4_LIQUIDITY_COMPOUNDER=
# Comma-separated fresh manager addresses. At least one is required.
V4_BASKET_MANAGERS=
V4_BASKET_FEE_COLLECTOR=
V4_GENESIS_REWARD_DISTRIBUTOR=
V4_BRIBE_ROUTER=

# Optional fresh v4 addresses.
V4_TREASURY_ADDRESS=
V4_FINAL_ADMIN=
DEPLOYER_ADDRESS=

# Optional fresh v4 liquidity values.
V4_DEX_TYPE=uniswap_v4
V4_UNISWAP_V4_POOL_ID=
V4_LIQUIDITY_HOOK=
V4_LIQUIDITY_VAULT=
V4_LIQUIDITY_COMPOUNDER=

# SQLite / Postgres database URL (Ponder database target)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nara_monitor
# Dedicated Ponder schema. Do not reuse a schema owned by another Ponder app.
DATABASE_SCHEMA=nara_v4_monitor

# Read-only Commander v1 SQL endpoint. Defaults to local Ponder API `/sql`.
COMMANDER_SQL_URL=http://localhost:42069/sql

# Read-only API/dashboard settings. Keep host local unless explicitly proxied.
API_HOST=127.0.0.1
API_PORT=42069
API_READ_ONLY=true
API_MAX_LIMIT=250

# AI Summarizer v1. Defaults to local_stub and only reads commander_reports.
AI_SUMMARY_PROVIDER=local_stub

# Notification outputs v1. Secrets stay in env only and are never stored.
NOTIFY_CHANNELS=console
NOTIFY_YELLOW=true
NOTIFY_GREEN=false
FORCE_NOTIFY=false
WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# AI Swarm keys (Ollama local endpoint or Gemini API)
GEMINI_API_KEY=

# (Optional) OpenZeppelin Monitor webhook
OZ_MONITOR_WEBHOOK_URL=
